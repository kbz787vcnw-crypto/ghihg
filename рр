    state: FSMContext
):
    if not is_admin(message.from_user.id):
        return

    value = (message.text or "").strip()

    if value != "-":
        match = BUTTON_RE.match(value)

        if not match:
            await message.answer(
                "Не понял формат. Пример:\n"
                "Перейти на сайт | https://example.com\n"
                "Или «-», чтобы без кнопки."
            )
            return

        await state.update_data(
            btn_text=match.group(1).strip(),
            btn_url=match.group(2)
        )

    data = await state.get_data()
    await state.set_state(None)  # данные остаются в FSM

    try:
        await bot.copy_message(
            chat_id=message.chat.id,
            from_chat_id=message.chat.id,
            message_id=data["msg_id"],
            reply_markup=make_markup(
                data.get("btn_text"), data.get("btn_url")
            )
        )
    except Exception as error:
        await state.clear()
        await message.answer(
            f"❌ Не удалось сделать предпросмотр: {error}",
            reply_markup=admin_menu(message.from_user.id)
        )
        return

    kb = InlineKeyboardBuilder()
    kb.button(text="✅ Отправить сейчас", callback_data="bc:now")
    kb.button(text="⏰ Запланировать", callback_data="bc:sched")
    kb.button(text="🧪 Тест мне", callback_data="bc:test")
    kb.button(text="❌ Отмена", callback_data="bc:no")
    kb.adjust(1, 1, 1, 1)

    await message.answer(
        f"Так увидят пользователи. Получателей: "
        f"{len(active_user_ids())}. Что делаем?",
        reply_markup=kb.as_markup()
    )


@router.callback_query(F.data.startswith("bc:"))
async def broadcast_actions(
    call: CallbackQuery,
    bot: Bot,
    state: FSMContext
):
    if not is_admin(call.from_user.id):
        await call.answer("Нет доступа", show_alert=True)
        return

    action = call.data.split(":", 1)[1]

    if action == "no":
        await state.clear()
        await call.answer("Отменено")
        await call.message.edit_text(
            "❌ Рассылка отменена.",
            reply_markup=admin_menu(call.from_user.id)
        )
        return

    data = await state.get_data()
    msg_id = data.get("msg_id")

    if not msg_id:
        await call.answer(
            "Сессия устарела. Начните рассылку заново.",
            show_alert=True
        )
        return

    chat_id = call.message.chat.id
    markup = make_markup(data.get("btn_text"), data.get("btn_url"))

    if action == "test":
        try:
            await bot.copy_message(
                chat_id=chat_id,
                from_chat_id=chat_id,
                message_id=msg_id,
                reply_markup=markup
            )
            await call.answer("Тест отправлен вам ✅")
        except Exception as error:
            await call.answer(f"Ошибка: {error}", show_alert=True)
        return

    if action == "sched":
        await state.set_state(AdminStates.schedule_time)
        await call.answer()
        await call.message.edit_text(
            f"⏰ Когда отправить? Часовой пояс: {TIMEZONE}\n\n"
            "Формат: ДД.ММ.ГГГГ ЧЧ:ММ\n"
            "Например: 20.10.2026 18:30",
            reply_markup=back_kb()
        )
        return

    if action == "now":
        if broadcast_lock.locked():
            await call.answer(
                "Другая рассылка ещё идёт, подождите.",
                show_alert=True
            )
            return

        await state.clear()
        await call.answer()
        await call.message.edit_text(
            "⏳ Рассылка запущена..."
        )

        sent, blocked, failed = await run_broadcast(
            bot, chat_id, msg_id, markup
        )

        await call.message.edit_text(
            report_text("✅ Рассылка завершена", sent, blocked, failed),
            reply_markup=admin_menu(call.from_user.id)
        )
        return

    await call.answer()


@router.message(AdminStates.schedule_time)
async def admin_schedule_time(message: Message, state: FSMContext):
    if not is_admin(message.from_user.id):
        return

    try:
        run_at = parse_local_time(message.text or "")
    except ValueError:
        await message.answer(
            "Не понял дату. Формат: ДД.ММ.ГГГГ ЧЧ:ММ, "
            "например 20.10.2026 18:30"
        )
        return

    if run_at <= datetime.now(timezone.utc):
        await message.answer(
            "Это время уже прошло. Укажите время в будущем."
        )
        return

    data = await state.get_data()

    if not data.get("msg_id"):
        await state.clear()
        await message.answer(
            "Сессия устарела. Начните рассылку заново.",
            reply_markup=admin_menu(message.from_user.id)
        )
        return

    sched_id = add_scheduled(
        run_at,
        message.from_user.id,
        message.chat.id,
        data["msg_id"],
        data.get("btn_text"),
        data.get("btn_url")
    )

    await state.clear()
    await message.answer(
        f"✅ Рассылка #{sched_id} запланирована на "
        f"{utc_str_to_local(run_at.strftime('%Y-%m-%d %H:%M:%S'))} "
        f"({TIMEZONE}).\n\n"
        "Не удаляйте исходное сообщение из чата с ботом.",
        reply_markup=admin_menu(message.from_user.id)
    )


async def scheduler(bot: Bot):
    """Фоновая задача: раз в 20 секунд запускает наступившие рассылки."""
    while True:
        try:
            for row in claim_due():
                sent, blocked, failed = await run_broadcast(
                    bot,
                    row["from_chat_id"],
                    row["message_id"],
                    make_markup(row["btn_text"], row["btn_url"])
                )
                finish_scheduled(row["id"])

                try:
                    await bot.send_message(
                        row["admin_id"],
                        report_text(
                            f"⏰ Отложенная рассылка #{row['id']} "
                            "завершена",
                            sent, blocked, failed
                        )
                    )
                except Exception:
                    logging.exception("Не удалось отправить отчёт")
        except Exception:
            logging.exception("Ошибка планировщика")

        await asyncio.sleep(20)


# ЗАПУСК БОТА
async def main():
    if not BOT_TOKEN:
        raise SystemExit(
            "Задайте токен: export BOT_TOKEN='ваш_токен'"
        )

    logging.basicConfig(level=logging.INFO)

    init_db()

    bot = Bot(BOT_TOKEN)
    dp = Dispatcher(storage=MemoryStorage())

    dp.include_router(router)

    scheduler_task = asyncio.create_task(scheduler(bot))

    try:
        await dp.start_polling(bot)
    finally:
        scheduler_task.cancel()
        await bot.session.close()


if __name__ == "__main__":
    asyncio.run(main())
