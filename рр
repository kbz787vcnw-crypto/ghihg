@router.message(CommandStart())
async def cmd_start(
    message: Message,
    bot: Bot,
    command: CommandObject,
    state: FSMContext
):
    if throttled(message.from_user.id, "start", 1.0):
        return

    await state.clear()

    source = None
    if command.args and SOURCE_RE.match(command.args):
        source = command.args

    save_user(message.from_user.id, source)

    await send_welcome(bot, message.chat.id)


@router.callback_query(F.data.startswith("go:"))
async def cb_go(call: CallbackQuery, state: FSMContext):
    if throttled(call.from_user.id, "go", 2.0):
        await call.answer()
        return

    await call.answer()

    try:
        await call.message.edit_reply_markup(reply_markup=None)
    except Exception:
        pass

    await state.set_state(UserStates.roblox_nick)
    await call.message.answer(
        "🎉 Поздравляем, подарок твой!\n\n"
        "🎮 Напиши свой ник в Roblox одним сообщением."
    )


@router.callback_query(F.data == "check_sub")
async def cb_check(call: CallbackQuery, bot: Bot):
    if throttled(call.from_user.id, "check", 3.0):
        await call.answer("Подождите пару секунд ⏳")
        return

    missing = await get_unsubscribed(bot, call.from_user.id)

    if missing:
        names = ", ".join(ch["title"] for ch in missing)
        await call.answer(
            f"Вы ещё не подписаны: {names}",
            show_alert=True
        )
        return

    await call.answer("Подписка подтверждена ✅")

    chat_id = call.message.chat.id
    try:
        await call.message.delete()
    except Exception:
        pass
    await send_access(bot, chat_id)


# ВХОД ПО ЗАЯВКЕ
@router.chat_join_request()
async def on_join_request(req: ChatJoinRequest, bot: Bot):
    join_id = get_setting("join_chat_id")

    if not join_id or str(req.chat.id) != join_id:
        return

    user_id = req.from_user.id
    missing = await get_unsubscribed(
        bot, user_id, exclude=req.chat.id
    )

    try:
        if not missing:
            await bot.approve_chat_join_request(
                req.chat.id, user_id
            )
            await send_access(bot, req.user_chat_id)
            return

        await send_subscribe(
            bot,
            req.user_chat_id,
            missing,
            check_data=f"jr:{req.chat.id}"
        )
    except Exception:
        logging.exception(
            "Ошибка обработки заявки от %s", user_id
        )


@router.callback_query(F.data.startswith("jr:"))
async def cb_join_check(call: CallbackQuery, bot: Bot):
    if throttled(call.from_user.id, "check", 3.0):
        await call.answer("Подождите пару секунд ⏳")
        return

    chat_id = int(call.data.split(":", 1)[1])

    missing = await get_unsubscribed(
        bot, call.from_user.id, exclude=chat_id
    )

    if missing:
        names = ", ".join(ch["title"] for ch in missing)
        await call.answer(
            f"Вы ещё не подписаны: {names}",
            show_alert=True
        )
        return

    try:
        await bot.approve_chat_join_request(
            chat_id, call.from_user.id
        )
    except Exception:
        logging.exception("Не удалось одобрить заявку")
        await call.answer(
            "Заявка не найдена или уже обработана. "
            "Подайте её заново.",
            show_alert=True
        )
        return

    await call.answer("Заявка одобрена ✅")

    msg_chat = call.message.chat.id
    try:
        await call.message.delete()
    except Exception:
        pass
    await send_access(bot, msg_chat)


