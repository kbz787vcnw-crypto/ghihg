def parse_channel_ref(message):
    """Достаёт ссылку на чат из пересылки, @username, t.me или ID."""
    origin = getattr(message, "forward_origin", None)

    if (
        origin is not None
        and getattr(origin, "chat", None) is not None
    ):
        return origin.chat.id

    if message.text:
        text = message.text.strip()

        if re.fullmatch(r"-?\d+", text):
            return int(text)

        match = re.search(
            r"(?:t\.me/|@)([A-Za-z0-9_]{4,})$",
            text
        )
        if match:
            return "@" + match.group(1)

    return None


