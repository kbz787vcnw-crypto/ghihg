# БАЗА ДАННЫХ
def db():
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    return conn


def init_db():
    with db() as c:
        c.execute("""
            CREATE TABLE IF NOT EXISTS channels (
                chat_id INTEGER PRIMARY KEY,
                title TEXT NOT NULL,
                link TEXT NOT NULL
            )
        """)
        c.execute("""
            CREATE TABLE IF NOT EXISTS settings (
                key TEXT PRIMARY KEY,
                value TEXT
            )
        """)
        c.execute("""
            CREATE TABLE IF NOT EXISTS users (
                user_id INTEGER PRIMARY KEY,
                joined_at TEXT,
                active INTEGER DEFAULT 1,
                source TEXT
            )
        """)
        c.execute("""
            CREATE TABLE IF NOT EXISTS admins (
                user_id INTEGER PRIMARY KEY
            )
        """)
        c.execute("""
            CREATE TABLE IF NOT EXISTS scheduled (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                run_at TEXT NOT NULL,
                admin_id INTEGER,
                from_chat_id INTEGER,
                message_id INTEGER,
                btn_text TEXT,
                btn_url TEXT,
                status TEXT DEFAULT 'pending'
            )
        """)

        # миграция старой таблицы users
        cols = [
            r["name"]
            for r in c.execute("PRAGMA table_info(users)")
        ]
        if "joined_at" not in cols:
            c.execute(
                "ALTER TABLE users ADD COLUMN joined_at TEXT"
            )
        if "active" not in cols:
            c.execute(
                "ALTER TABLE users "
                "ADD COLUMN active INTEGER DEFAULT 1"
            )
        if "source" not in cols:
            c.execute(
                "ALTER TABLE users ADD COLUMN source TEXT"
            )
        for col in ("roblox_nick", "nick_at", "tg_username"):
            if col not in cols:
                c.execute(
                    f"ALTER TABLE users ADD COLUMN {col} TEXT"
                )


def list_channels():
    with db() as c:
        return c.execute(
            "SELECT * FROM channels ORDER BY title"
        ).fetchall()


def add_channel(chat_id, title, link):
    with db() as c:
        c.execute(
            "INSERT OR REPLACE INTO channels VALUES (?, ?, ?)",
            (chat_id, title, link)
        )


def remove_channel(chat_id):
    with db() as c:
        c.execute(
            "DELETE FROM channels WHERE chat_id = ?",
            (chat_id,)
        )


def get_setting(key, default=""):
    with db() as c:
        row = c.execute(
            "SELECT value FROM settings WHERE key = ?",
            (key,)
        ).fetchone()
    return row["value"] if row else default


def set_setting(key, value):
    with db() as c:
        c.execute(
            "INSERT OR REPLACE INTO settings VALUES (?, ?)",
            (key, value)
        )


