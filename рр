# РАССЫЛКА
def make_markup(btn_text, btn_url):
    if not btn_text or not btn_url:
        return None

    kb = InlineKeyboardBuilder()
    kb.button(text=btn_text, url=btn_url)
    return kb.as_markup()


async def send_one(bot, user_id, from_chat_id, message_id, markup):
    """Возвращает 'ok', 'blocked' или 'fail'."""
    for _ in range(2):
        try:
            await bot.copy_message(
                chat_id=user_id,
                from_chat_id=from_chat_id,
                message_id=message_id,
                reply_markup=markup
            )
            return "ok"
        except TelegramRetryAfter as e:
            await asyncio.sleep(e.retry_after + 1)
        except TelegramForbiddenError:
            return "blocked"
        except Exception:
            logging.exception("Рассылка: ошибка для %s", user_id)
            return "fail"
    return "fail"


async def run_broadcast(bot, from_chat_id, message_id, markup):
    """Рассылает всем активным. Возвращает (sent, blocked, failed)."""
    sent = blocked = failed = 0

    async with broadcast_lock:
        for uid in active_user_ids():
            result = await send_one(
                bot, uid, from_chat_id, message_id, markup
            )

            if result == "ok":
                sent += 1
            elif result == "blocked":
                blocked += 1
                set_user_active(uid, False)
            else:
                failed += 1

            await asyncio.sleep(0.05)  # ~20 сообщений/сек

    return sent, blocked, failed


def report_text(title, sent, blocked, failed):
    return (
        f"{title}\n\n"
        f"📬 Доставлено: {sent}\n"
        f"🚫 Заблокировали бота: {blocked}\n"
        f"⚠️ Ошибок: {failed}"
    )


