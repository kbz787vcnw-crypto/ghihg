def stats_text():
    with db() as c:
        total = c.execute(
            "SELECT COUNT(*) FROM users"
        ).fetchone()[0]
        active = c.execute(
            "SELECT COUNT(*) FROM users WHERE active = 1"
        ).fetchone()[0]

        def new_since(days):
            return c.execute(
                "SELECT COUNT(*) FROM users "
                "WHERE date(joined_at) >= date('now', ?)",
                (f"-{days} days",)
            ).fetchone()[0]

        today = new_since(0)
        week = new_since(6)
        month = new_since(29)

        by_day = c.execute(
            "SELECT date(joined_at) AS d, COUNT(*) AS n "
            "FROM users "
            "WHERE date(joined_at) >= date('now', '-6 days') "
            "GROUP BY d ORDER BY d DESC"
        ).fetchall()

        sources = c.execute(
            "SELECT source, COUNT(*) AS n FROM users "
            "WHERE source IS NOT NULL "
            "GROUP BY source ORDER BY n DESC LIMIT 10"
        ).fetchall()

    days = "\n".join(
        f"• {r['d']} — {r['n']}" for r in by_day
    ) or "—"

    src = "\n".join(
        f"• {r['source']} — {r['n']}" for r in sources
    ) or "—"

    return (
        "📊 Статистика (время UTC)\n\n"
        f"👥 Всего: {total}\n"
        f"✅ Активных: {active}\n"
        f"🚫 Заблокировали бота: {total - active}\n\n"
        f"🆕 Новых сегодня: {today}\n"
        f"🗓 За 7 дней: {week}\n"
        f"🗓 За 30 дней: {month}\n"
        f"📢 Каналов: {len(list_channels())}\n\n"
        f"Новые по дням:\n{days}\n\n"
        f"Источники (топ-10):\n{src}"
    )


