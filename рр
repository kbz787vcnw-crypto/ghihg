            "INSERT OR IGNORE INTO users "
            "(user_id, joined_at, active, source) "
            "VALUES (?, datetime('now'), 1, ?)",
            (user_id, source)
        )
        c.execute(
            "UPDATE users SET active = 1 WHERE user_id = ?",
            (user_id,)
        )


