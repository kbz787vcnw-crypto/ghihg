def parse_local_time(text):
    """'ДД.ММ.ГГГГ ЧЧ:ММ' в TIMEZONE -> aware datetime в UTC."""
    dt = datetime.strptime(text.strip(), "%d.%m.%Y %H:%M")
    dt = dt.replace(tzinfo=ZoneInfo(TIMEZONE))
    return dt.astimezone(timezone.utc)


def utc_str_to_local(value):
    dt = datetime.strptime(value, "%Y-%m-%d %H:%M:%S")
    dt = dt.replace(tzinfo=timezone.utc)
    return dt.astimezone(ZoneInfo(TIMEZONE)).strftime(
        "%d.%m.%Y %H:%M"
    )


def add_scheduled(
    run_at_utc, admin_id, from_chat_id,
    message_id, btn_text, btn_url
):
    with db() as c:
        cur = c.execute(
            "INSERT INTO scheduled "
            "(run_at, admin_id, from_chat_id, message_id, "
            "btn_text, btn_url) VALUES (?, ?, ?, ?, ?, ?)",
            (
                run_at_utc.strftime("%Y-%m-%d %H:%M:%S"),
                admin_id, from_chat_id, message_id,
                btn_text, btn_url,
            )
        )
        return cur.lastrowid


def list_scheduled():
    with db() as c:
        return c.execute(
            "SELECT * FROM scheduled WHERE status = 'pending' "
            "ORDER BY run_at"
        ).fetchall()


def cancel_scheduled(sched_id):
    with db() as c:
        c.execute(
            "UPDATE scheduled SET status = 'cancelled' "
            "WHERE id = ? AND status = 'pending'",
            (sched_id,)
        )


def claim_due():
    """Забирает наступившие рассылки (помечает как running)."""
    claimed = []
    with db() as c:
        rows = c.execute(
            "SELECT * FROM scheduled WHERE status = 'pending' "
            "AND run_at <= datetime('now') ORDER BY run_at"
        ).fetchall()
        for row in rows:
            cur = c.execute(
                "UPDATE scheduled SET status = 'running' "
                "WHERE id = ? AND status = 'pending'",
                (row["id"],)
            )
            if cur.rowcount:
                claimed.append(row)
    return claimed


def finish_scheduled(sched_id):
    with db() as c:
        c.execute(
            "UPDATE scheduled SET status = 'done' WHERE id = ?",
            (sched_id,)
        )


# АНТИСПАМ
_last_action = {}


def throttled(user_id, key, seconds=3.0):
    now = time.monotonic()
    k = (user_id, key)

    if now - _last_action.get(k, 0) < seconds:
        return True

    _last_action[k] = now

    if len(_last_action) > 20000:
        for old in [
            kk for kk, t in _last_action.items()
            if now - t > 60
        ]:
            _last_action.pop(old, None)

    return False


# ПРОВЕРКА ПОДПИСКИ
async def get_unsubscribed(bot, user_id, exclude=None):
    missing = []

    for ch in list_channels():
        if exclude is not None and ch["chat_id"] == exclude:
            continue

        try:
            member = await bot.get_chat_member(
                ch["chat_id"], user_id
            )

            subscribed = (
                member.status in (
                    "member", "administrator", "creator"
                )
                or (
                    member.status == "restricted"
                    and getattr(member, "is_member", False)
                )
            )

            if not subscribed:
                missing.append(ch)

        except Exception:
            logging.exception(
                "Ошибка проверки канала %s",
                ch["chat_id"]
            )
            missing.append(ch)

    return missing


